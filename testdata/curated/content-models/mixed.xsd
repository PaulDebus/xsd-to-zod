<?xml version="1.0"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:curated" xmlns:t="urn:curated" elementFormDefault="qualified">
  <xs:complexType name="ParagraphType" mixed="true">
    <xs:sequence>
      <xs:element name="bold" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="italic" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="paragraph" type="t:ParagraphType"/>
</xs:schema>
